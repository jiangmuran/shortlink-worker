{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortlink",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortlink",
      // 运行 `npx wrangler d1 create shortlink` 后把输出的 database_id 填到这里
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "./migrations"
    }
  ],
  // 可选：直接在配置里绑定自定义域（也可以在 Dashboard 里手动添加）
  // "routes": [
  //   { "pattern": "sl.example.com", "custom_domain": true },
  //   { "pattern": "s.example.com", "custom_domain": true }
  // ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "triggers": {
    // 每小时第 17 分钟运行一次清理任务
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
